---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { profile } from '../../data/profile';
import type { Lang } from '../../i18n/ui';
import { langParams, useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const p = profile[lang];
const cvUrl = site.cv[lang];
---

<BaseLayout title={t('about.title')} description={t('about.description')} lang={lang}>
  <section class="section">
    <div class="container">
      <h1>{t('about.title')}</h1>
      <div class="prose">
        {p.bio.map((para) => <p>{para}</p>)}
        {cvUrl && (
          <p>
            <a class="btn btn-outline" href={cvUrl} download>{t('about.cv')}</a>
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t('about.skills')}</h2>
      <div class="grid skills">
        {p.skills.map((group) => (
          <div class="card">
            <h3>{group.name}</h3>
            <ul class="tags">
              {group.items.map((item) => <li class="tag">{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t('about.experience')}</h2>
      <ol class="timeline">
        {p.experience.map((item) => (
          <li class="timeline-item">
            <span class="timeline-period">{item.period}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="timeline-org">{item.org}</p>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{t('about.education')}</h2>
      <ol class="timeline">
        {p.education.map((item) => (
          <li class="timeline-item">
            <span class="timeline-period">{item.period}</span>
            <div>
              <h3>{item.title}</h3>
              <p class="timeline-org">{item.org}</p>
              <p>{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .skills h3 {
    margin-bottom: 0.25rem;
    font-size: 1.05rem;
  }
</style>
