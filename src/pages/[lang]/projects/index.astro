---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getProjects } from '../../../data/projects';
import type { Lang } from '../../../i18n/ui';
import { langParams, useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return langParams();
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout title={t('projects.title')} description={t('projects.description')} lang={lang}>
  <section class="section">
    <div class="container">
      <h1>{t('projects.title')}</h1>
      <p class="lead">{t('projects.intro')}</p>

      {projects.length === 0 ? (
        <p class="muted">{t('projects.empty')}</p>
      ) : (
        <div class="grid projects-grid">
          {projects.map((p) => <ProjectCard project={p} lang={lang} headingLevel="h2" />)}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-grid {
    margin-top: 2rem;
  }
</style>
